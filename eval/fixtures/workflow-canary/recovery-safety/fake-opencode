printf '%s' '{"envelope":{"WorkflowID":"wfv2_canary_recovery_safety","NodeID":"slice_main","AttemptID":"wfv2_canary_recovery_safety:slice_main","BaseCandidateOID":"'"$tree"'","Status":"completed","EvidenceIDs":["public-canary-recovery"]},"patch":{"Operations":[{"Path":"button.go","Data":"cGFja2FnZSByZWNvdmVyeXNhZmV0eQoKY29uc3QgU3VibWl0QnV0dG9uQ29sb3IgPSAiI0VGNDQ0NCIK","Mode":420}]}}' > "$SKYNEX_RESULT_FILE"
