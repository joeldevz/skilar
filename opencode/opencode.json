{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "workflow-orchestrator": {
      "description": "Dedicated Skynex Workflow V2 coordinator. Uses skynex workflow as the sole workflow authority.",
      "mode": "all",
      "model": "openai/gpt-5.6-terra",
      "prompt": "{file:./agents/workflow-orchestrator.md}",
      "tools": {"bash": true, "edit": true, "read": true, "write": true, "glob": true, "grep": true, "neurox_context": true, "neurox_recall": true}
    },
    "workflow-reviewer": {
      "description": "Primary read-only reviewer for one Skynex Workflow V2 semantic or lens review.",
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./agents/workflow-reviewer.md}",
      "tools": {"bash": true, "read": true, "glob": true, "grep": true, "write": false, "edit": false, "task": false}
    },
    "workflow-worker": {
      "description": "Primary non-interactive worker for one fenced Skynex Workflow V2 mutation attempt.",
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./agents/workflow-worker.md}",
      "tools": {"bash": true, "read": true, "glob": true, "grep": true, "write": false, "edit": false, "task": false}
    },
    "orchestrator": {
      "description": "Orchestrator — pure coordination agent. Delegates all work to sub-agents. NEVER writes code. Reads a few files to decide, launches parallel sub-agents, synthesizes results.",
      "mode": "all",
      "prompt": "{file:./agents/orchestrator.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true,
        "glob": true,
        "grep": true,
        "neurox_context": true,
        "neurox_recall": true
      },
      "model": "openai/gpt-5.6-terra"
    },
    "skynex-orchestrator": {
      "description": "Lean standalone orchestrator — risk-based delegation and lineage-bound results without using the Skynex workflow engine.",
      "mode": "all",
      "prompt": "{file:./agents/skynex-orchestrator.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true,
        "glob": true,
        "grep": true,
        "task": true,
        "neurox_context": true,
        "neurox_recall": true
      },
      "model": "openai/gpt-5.6-terra"
    },
    "task-classifier": {
      "description": "Read-only request classifier for the standalone orchestrator.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./agents/task-classifier.md}",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "neurox_recall": true,
        "bash": false,
        "edit": false,
        "write": false,
        "task": false
      }
    },
    "coder": {
      "description": "Use for one bounded coding task. TDD is mandatory: prove the focused test red, make the minimal change, and hand off only with relevant tests green.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./agents/coder.md}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "neurox_context": true,
        "neurox_recall": true
      }
    },

    "infrastructure-engineer": {
      "description": "Owns bounded infrastructure, CI/CD, runtime, deployment, build, and developer-environment work with fresh upstream quality-tool resolution and safe verification.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "prompt": "{file:./agents/infrastructure-engineer.md}",
      "tools": {
        "bash": true,
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "grep": true,
        "neurox_session_start": true,
        "neurox_context": true,
        "neurox_recall": true,
        "neurox_save": true,
        "neurox_update": true,
        "neurox_session_end": true
      }
    },

    "test-engineer": {
      "description": "Writes the behavior-focused red test contract before coder implementation; never changes production code.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./agents/test-engineer.md}",
      "tools": {
        "bash": true,
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "grep": true,
        "neurox_context": true,
        "neurox_recall": true
      }
    },

    "tech-planner": {
      "model": "openai/gpt-5.6-terra",
      "description": "Technical Planner - reads the task (or an existing SPEC), does deep codebase discovery, and produces a prescriptive PLAN.md where every step has a mandatory How section with exact file paths, signatures, and snippets",
      "mode": "subagent",
      "prompt": "{file:./agents/tech-planner.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true,
        "neurox_context": true,
        "neurox_recall": true
      }
    },
    "verifier": {
      "description": "Use after each coder step to run lint, build, and tests on the modified files. Returns pass/fail with structured verifier_feedback.",
      "mode": "subagent",
      "prompt": "{file:./agents/verifier.md}",
      "tools": {
        "bash": true,
        "read": true,
        "glob": true,
        "grep": true,
        "neurox_context": true,
        "neurox_recall": true
      },
      "model": "openai/gpt-5.6-luna"
    },
    "test-reviewer": {
      "model": "openai/gpt-5.6-luna",
      "description": "Use after plan completion to review test coherence and quality. Classifies each test file as SOUND, WEAK, or MISLEADING.",
      "mode": "subagent",
      "prompt": "{file:./agents/test-reviewer.md}",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "neurox_context": true,
        "neurox_recall": true
      }
    },
    "security": {
      "model": "openai/gpt-5.6-terra",
      "description": "Use as one of two parallel adversarial security judges. Finds vulnerabilities in injection, auth, data exposure, rate limiting, crypto, dependencies.",
      "mode": "subagent",
      "prompt": "{file:./agents/security.md}",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "neurox_context": true,
        "neurox_recall": true
      }
    },
    "skill-validator": {
      "model": "openai/gpt-5.6-luna",
      "description": "Skill Validator - validates implemented code against project skill registry at end of plan. Flags deviations from documented patterns, naming conventions, and architectural rules.",
      "mode": "subagent",
      "prompt": "{file:./agents/skill-validator.md}",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "neurox_recall": true,
        "neurox_context": true
      }
    },
    "pr-reviewer": {
      "model": "openai/gpt-5.6-terra",
      "description": "Adversarial PR review judge for a single 4R+1 dimension (Correctness/Risk/Readability/Reliability/Resilience). Launched in parallel by the orchestrator. Read-only.",
      "mode": "subagent",
      "prompt": "{file:./agents/pr-reviewer.md}",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "neurox_recall": true,
        "neurox_context": true
      }
    }
  },
  "provider": {},
  "mcp": {
    "atlassian": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "brevo": {
      "type": "remote",
      "url": "https://mcp.brevo.com/v1/brevo/mcp",
      "headers": {
        "Authorization": "Bearer ${BREVO_API_KEY}"
      },
      "enabled": true
    },
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@0.23.0"
      ],
      "enabled": true,
      "environment": {
        "CDP_URL": "http://localhost:9222",
        "CHROME_PATH": "/usr/bin/chromium"
      },
      "timeout": 30000,
      "type": "local"
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "exa": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "figma": {
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp@0.11.0",
        "--stdio"
      ],
      "enabled": true,
      "environment": {
        "DO_NOT_TRACK": "1",
        "FIGMA_API_KEY": "${FIGMA_API_KEY}",
        "FRAMELINK_TELEMETRY": "off"
      },
      "timeout": 15000,
      "type": "local"
    },
    "jina-mcp-server": {
      "type": "remote",
      "url": "https://mcp.jina.ai/v1"
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "neurox": {
      "command": [
        "neurox",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "slack": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "environment": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      },
      "enabled": true
    }
  },
  "plugin": [
    "opencode-anthropic-login-via-cli",
    "@ex-machina/opencode-anthropic-auth"
  ],
  "small_model": "anthropic/claude-haiku-4-5"
}
